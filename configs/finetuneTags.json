{
    "data": {
        "datasetDir": "dataset",
        "fontSize": 32,
        "minTagCount": 1
    },
    "model": {
        "backbone": "checkpoints/pretrain/best",
        "hidden": 1024
    },
    "training": {
        "epochs": 30,
        "headOnlyEpochs": 3,
        "batchFonts": 64,
        "glyphsPerFont": 8,
        "headLR": 1e-3,
        "backboneLR": 1e-5,
        "weightDecay": 0.05,
        "loss": "bce",
        "shiftAug": 0,
        "patience": 5,
        "seed": 0,
        "autocast": true
    },
    "output": {
        "outDir": "checkpoints/retrieval/finetuneTags"
    }
}
