# Line endings: text files are stored and checked out with LF on every OS (the repo had drifted into a mix of
# CRLF and LF, which made every edit on Windows show up as a whole-file change). Binary files are auto-detected;
# the LFS rules below take precedence for the files they name.
* text=auto eol=lf

*.safetensors filter=lfs diff=lfs merge=lfs -text
embeddings/all.json filter=lfs diff=lfs merge=lfs -text
checkpoints/pretrain/best/checkpoint.pt filter=lfs diff=lfs merge=lfs -text
# The search bundle the site serves (site/tools builds it). manifest.json stays plain text so a change is reviewable.
site/backend/data/logits.npy filter=lfs diff=lfs merge=lfs -text
site/backend/data/specimens.pack filter=lfs diff=lfs merge=lfs -text
site/backend/data/fonts.json filter=lfs diff=lfs merge=lfs -text
site/backend/data/vocab.json filter=lfs diff=lfs merge=lfs -text
# Map page exports, several MB each
site/frontend/public/flower.html filter=lfs diff=lfs merge=lfs -text
site/frontend/public/blob.html filter=lfs diff=lfs merge=lfs -text
